# SciKick — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# SQLite database path (relative to project root)
DATABASE_PATH=data/futbol.db

# Service token for POST /api/refresh (autogenerate in M0 if empty)
SERVICE_TOKEN=

# API-Football key (free tier: seasons 2022-2024 only, no current data)
API_FOOTBALL_KEY=

# Enable API-Football lineup resolution (needs Pro for current season, else dormant)
LINEUPS_ENABLED=false

# football-data.org key (free tier: 10 req/min, primary fixtures source)
FOOTBALL_DATA_ORG_KEY=

# The Odds API key (free tier: 500 credits/month, 1 credit per league per day)
ODDS_API_KEY=

# Enable xG features via Understat scraping (true/false)
XG_ENABLED=true

# League codes to sync on startup (comma-separated: E0,SP1,D1,I1,F1)
LEAGUES_INITIAL=E0,SP1,D1,I1,F1

# Scheduler settings
SCHEDULER_SYNC_HOUR=6
SCHEDULER_RETRAIN_DAY=sunday
SCHEDULER_LINEUPS_HOUR=5
SCHEDULER_LINEUPS_MINUTE=30

# App environment (production|test)
ENV=production
