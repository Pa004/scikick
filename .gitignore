# === Environment ===
.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# === Data (regenerable, except committed EC1 history) ===
data/*
!data/raw/
data/raw/*
# Immutable past EC1 seasons from ESPN; current year re-crawls each run.
!data/raw/EC120*.csv
data/raw/EC12026.csv
backups/

# === Model artifacts (too large, metrics.json documented in README) ===
# Ignore generated run artifacts but keep the manager source code.
app/models/runs/*
!app/models/runs/.gitkeep
!app/models/runs/manager.py
!app/models/runs/__init__.py

# === Frontend ===
node_modules/
frontend/node_modules/
frontend/dist/

# === SQLite ===
*.db
*.db-wal
*.db-shm

# === Cloudflare static export (regenerable via export-cloudflare.yml) ===
dist-cf/

# === Logs ===
logs/

# === Playwright MCP artifacts ===
.playwright-mcp/

# === Documentation (only root README.md is versioned) ===
*.md
!/README.md
!/docs/retrain.md
!/docs/adr/*.md

# === Local audit artifacts (not versioned) ===
docs/audit/
